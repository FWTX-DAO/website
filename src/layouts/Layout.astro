---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import NeuralBackground from "@components/ui/flow-field-background";
import "@fontsource-variable/plus-jakarta-sans/index.css";
import "@fontsource/teko/400.css";
import "@fontsource/teko/500.css";
import "@fontsource/teko/600.css";
import "@fontsource/teko/700.css";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  publishDate?: string;
  author?: string;
  tags?: string[];
  type?: "website" | "article";
  background?: "default" | "quiet";
}

const { title, description, image, imageAlt, noindex, publishDate, author, tags, type = "website", background = "default" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const organizationId = "https://fwtx.city/#organization";
const websiteId = "https://fwtx.city/#website";
const defaultDescription = "Fort Worth DAO is a Web3 community and nonprofit DAO advancing education, digital sovereignty, and civic innovation across Fort Worth and Greater Texas.";
const pageTitle = title
  ? `${title} | Fort Worth DAO`
  : "Fort Worth DAO | Web3 Community & Nonprofit DAO";
const metaDescription = description || defaultDescription;

const backgroundSettings = background === "quiet"
  ? {
      trailOpacity: 0.035,
      particleCount: 140,
      speed: 0.18,
    }
  : {
      trailOpacity: 0.12,
      particleCount: 400,
      speed: 0.6,
    };

const organizationSchema = {
  "@context": "https://schema.org",
  "@id": organizationId,
  "@type": ["Organization", "NGO"],
  name: "Fort Worth DAO",
  alternateName: ["FWTX DAO", "Fort Worth Municipal DAO"],
  legalName: "Fort Worth DAO LCA",
  url: "https://fwtx.city",
  logo: "https://fwtx.city/logo.svg",
  email: "community@fwtx.city",
  taxID: "41-2815082",
  nonprofitStatus: "https://schema.org/Nonprofit501c3",
  description: defaultDescription,
  slogan: "Digital Sovereignty is Mission Critical",
  foundingDate: "2023-12-19",
  areaServed: [
    {
      "@type": "City",
      name: "Fort Worth",
      containedInPlace: {
        "@type": "State",
        name: "Texas",
      },
    },
    {
      "@type": "AdministrativeArea",
      name: "Greater Texas",
    },
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Fort Worth",
    addressRegion: "TX",
    addressCountry: "US",
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      email: "community@fwtx.city",
      contactType: "community and membership",
      url: "https://fwtx.city/contact",
      availableLanguage: "English",
    },
    {
      "@type": "ContactPoint",
      email: "hello@fwtx.city",
      contactType: "partnerships and sponsorships",
      url: "https://fwtx.city/contact",
      availableLanguage: "English",
    },
  ],
  knowsAbout: [
    "Web3 education",
    "decentralized autonomous organizations",
    "digital sovereignty",
    "blockchain governance",
    "cybersecurity",
    "civic technology",
    "open source software",
    "workforce development",
  ],
  potentialAction: {
    "@type": "JoinAction",
    name: "Join Fort Worth DAO",
    target: "https://dao.fwtx.city",
  },
  sameAs: [
    "https://x.com/FWTX_DAO",
    "https://github.com/FWTX-DAO",
    "https://www.linkedin.com/company/fwtx-dao",
    "https://www.youtube.com/@fortworthdao",
    "https://www.instagram.com/fwtx_dao",
    "https://t.me/fwtxdao",
  ],
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@id": websiteId,
  "@type": "WebSite",
  name: "Fort Worth DAO",
  alternateName: "FWTX DAO",
  url: "https://fwtx.city",
  description: defaultDescription,
  inLanguage: "en-US",
  publisher: { "@id": organizationId },
  about: { "@id": organizationId },
  hasPart: [
    {
      "@type": "WebSite",
      name: "Fort Worth DAO Member Portal",
      url: "https://dao.fwtx.city",
      description: "Account access, active membership, and participation in Fort Worth DAO governance.",
    },
    {
      "@type": "WebSite",
      name: "Fort Worth DAO Constitution and Whitepaper",
      url: "https://constitution.fwtx.city",
      description: "The mission, membership expectations, governance structure, and cybersecurity framework of Fort Worth DAO.",
    },
    {
      "@type": "WebSite",
      name: "HackFW",
      url: "https://hack.fwtx.city",
      description: "Fort Worth DAO's flagship hackathon program, with current dates, registration, and partner information.",
    },
    {
      "@type": "WebSite",
      name: "FWTX Innovation Bounties",
      url: "https://innovate.fwtx.city",
      description: "A submission portal for community, civic, and technical challenge proposals.",
    },
    {
      "@type": "WebSite",
      name: "Fort Worth Talent Network",
      url: "https://talent.fwtx.city",
      description: "Profiles and connections for local builders, employers, and technology opportunities.",
    },
  ],
};

const resolvedImageWithDomain = new URL(
  image || "/ogimage.png",
  Astro.site
).toString();

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalURL}#webpage`,
  url: canonicalURL,
  name: pageTitle,
  description: metaDescription,
  inLanguage: "en-US",
  isPartOf: { "@id": websiteId },
  about: { "@id": organizationId },
  publisher: { "@id": organizationId },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: resolvedImageWithDomain,
  },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="alternate" type="application/rss+xml" title="FWTX DAO Blog" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A0F1C" />

    <SEO
      title={pageTitle}
      description={metaDescription}
      canonical={canonicalURL}
      noindex={noindex}
      nofollow={noindex}
      twitter={{
        creator: "@FWTX_DAO",
        site: "@FWTX_DAO",
        card: "summary_large_image",
        title: pageTitle,
        description: metaDescription,
        image: resolvedImageWithDomain,
        imageAlt: imageAlt || "Fort Worth DAO - Digital Sovereignty is Mission Critical",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: type,
          title: pageTitle,
          image: resolvedImageWithDomain,
        },
        optional: {
          description: metaDescription,
          locale: "en_US",
          siteName: "Fort Worth DAO",
        },
        image: {
          alt: imageAlt || "FWTX DAO - Digital Sovereignty is Mission Critical",
          width: 1200,
          height: 630,
        },
      }}
    />

    {type === "article" && publishDate && (
      <meta property="article:published_time" content={publishDate} />
    )}
    {type === "article" && author && (
      <meta property="article:author" content={author} />
    )}
    {type === "article" && tags && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />

    <meta name="author" content="Fort Worth DAO" />
    <meta name="keywords" content={["Fort Worth", "Greater Texas", "DAO", "Web3 community", "501(c)(3) nonprofit", "blockchain", "civic innovation", "digital sovereignty", "cybersecurity", "decentralized governance", ...(tags || [])].join(", ")} />
    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content="Fort Worth, Texas" />
    <link rel="alternate" hreflang="en-US" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Fort Worth DAO information for AI systems" />

    <link rel="apple-touch-icon" sizes="180x180" href="/logo.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/logo.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/logo.svg" />

    <slot name="head" />
  </head>
  <body class="bg-navy-950 min-h-screen text-gray-100 antialiased pt-20">
    <!-- Skip navigation -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-blue-500 focus:text-white focus:font-semibold">Skip to content</a>

    <!-- Flow field background -->
    <div class="fixed inset-0 z-0 h-screen w-screen overflow-hidden" aria-hidden="true">
      <NeuralBackground
        client:load
        className="absolute inset-0 h-full w-full"
        color="#3b82f6"
        bgColor="#0A0F1C"
        trailOpacity={backgroundSettings.trailOpacity}
        particleCount={backgroundSettings.particleCount}
        speed={backgroundSettings.speed}
      />
    </div>
    {background === "quiet" && (
      <div class="pointer-events-none fixed inset-0 z-[1] bg-navy-950/80 backdrop-blur-sm" aria-hidden="true"></div>
    )}

    <!-- Main content -->
    <div class="relative z-10" id="main-content">
      <Navbar />
      <slot />
      <Footer />
    </div>

    <style is:global>
      img {
        content-visibility: auto;
      }

      html {
        color-scheme: dark;
        scroll-behavior: smooth;
      }

      h1, h2, h3, h4, h5, h6 {
        text-wrap: balance;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }

      body {
        background-color: #0A0F1C;
      }

      ::selection {
        background-color: rgba(59, 130, 246, 0.3);
        color: #dbeafe;
      }

      ::-webkit-scrollbar {
        width: 8px;
      }

      ::-webkit-scrollbar-track {
        background: #0A0F1C;
      }

      ::-webkit-scrollbar-thumb {
        background: #3b82f6;
        border-radius: 4px;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: #60a5fa;
      }

      /* Accent text */
      .accent-text {
        color: #60a5fa;
      }

      /* Glass card */
      .glass-card {
        background: rgba(15, 22, 41, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(59, 130, 246, 0.1);
      }

      .glass-card:hover {
        border-color: rgba(59, 130, 246, 0.25);
        box-shadow: 0 0 30px rgba(59, 130, 246, 0.06);
      }

      /* Link styling */
      .cyber-link {
        position: relative;
        color: #94a3b8;
        transition: color 0.3s ease;
      }

      .cyber-link:hover {
        color: #60a5fa;
      }

      .cyber-link::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 1px;
        background: #3b82f6;
        transition: width 0.3s ease;
      }

      .cyber-link:hover::after {
        width: 100%;
      }

      /* Prose dark mode for blog content */
      .prose-invert {
        --tw-prose-body: #cbd5e1;
        --tw-prose-headings: #f1f5f9;
        --tw-prose-lead: #94a3b8;
        --tw-prose-links: #60a5fa;
        --tw-prose-bold: #f1f5f9;
        --tw-prose-counters: #94a3b8;
        --tw-prose-bullets: #3b82f6;
        --tw-prose-hr: rgba(59, 130, 246, 0.2);
        --tw-prose-quotes: #e2e8f0;
        --tw-prose-quote-borders: #3b82f6;
        --tw-prose-captions: #94a3b8;
        --tw-prose-code: #60a5fa;
        --tw-prose-pre-code: #e2e8f0;
        --tw-prose-pre-bg: rgba(15, 22, 41, 0.8);
        --tw-prose-th-borders: rgba(59, 130, 246, 0.2);
        --tw-prose-td-borders: rgba(100, 116, 139, 0.3);
      }

      .font-display {
        font-family: 'Teko', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }
    </style>
  </body>
</html>
