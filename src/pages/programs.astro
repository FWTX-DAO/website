---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";

const programs = [
  {
    name: "HackFW",
    availability: "Builders · Open",
    description:
      "Fort Worth's flagship hackathon brings builders together to solve real challenges with civic and industry partners.",
    href: "https://hack.fwtx.city",
    cta: "Build with HackFW",
    external: true,
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    name: "Partners",
    availability: "Sponsorships open",
    description:
      "Sponsor HackFW and other FWTX DAO programs that strengthen Fort Worth's builder and innovation community.",
    href: "/donate#sponsorship",
    cta: "View sponsor options",
    external: false,
    icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l2.036 6.265a1 1 0 00.95.69h6.59c.969 0 1.371 1.24.588 1.81l-5.33 3.872a1 1 0 00-.364 1.118l2.036 6.265c.3.921-.755 1.688-1.539 1.118l-5.33-3.872a1 1 0 00-1.176 0l-5.33 3.872c-.783.57-1.838-.197-1.539-1.118l2.036-6.265a1 1 0 00-.364-1.118l-5.33-3.872c-.783-.57-.38-1.81.588-1.81h6.59a1 1 0 00.95-.69l2.036-6.265z",
  },
  {
    name: "Fort Worth Innovation Forum @ The Fort Worth Club",
    availability: "Invite only",
    description:
      "A private gathering for civic leaders, industry executives, and emerging technologists shaping Fort Worth's future.",
    href: "/contact",
    cta: "Request an invitation",
    external: false,
    icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
  },
  {
    name: "Community Roundtables",
    availability: "Open door",
    description:
      "Weekly, open conversations for anyone interested in technology, digital sovereignty, and Fort Worth's future.",
    href: "https://dao.fwtx.city",
    cta: "Join the DAO",
    external: true,
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656-.126-1.283-.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
  },
];

const involvementSteps = [
  {
    step: "01",
    title: "Attend Roundtables & Workshops",
    body: "See upcoming roundtables, workshops, and community events on the FWTX DAO calendar.",
    href: "https://luma.com/fwtxdao",
    cta: "View the Luma calendar",
  },
  {
    step: "02",
    title: "Explore Innovation Bounties",
    body: "Submit an idea or take on a community-funded challenge that creates open civic technology.",
    href: "https://innovate.fwtx.city",
    cta: "Explore innovation bounties",
  },
  {
    step: "03",
    title: "Contribute to Open Source",
    body: "Browse FWTX DAO repositories and help build open source tools, guides, and civic infrastructure.",
    href: "https://github.com/FWTX-DAO",
    cta: "Browse GitHub",
  },
  {
    step: "04",
    title: "Become a Member",
    body: "Sign up for active membership and take part in FWTX DAO governance and community programs.",
    href: "https://dao.fwtx.city",
    cta: "Join the DAO",
  },
];

const howToJoinSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Join FWTX DAO Programs",
  description: "Step-by-step guide to participating in FWTX DAO community programs in Fort Worth, Texas.",
  step: [
    {
      "@type": "HowToStep",
      position: 1,
      name: "Attend Roundtables and Workshops",
      text: "View upcoming roundtables, workshops, and community events on the FWTX DAO Luma calendar.",
      url: "https://luma.com/fwtxdao",
    },
    {
      "@type": "HowToStep",
      position: 2,
      name: "Explore Innovation Bounties",
      text: "Submit an idea or take on a community-funded challenge at innovate.fwtx.city.",
      url: "https://innovate.fwtx.city",
    },
    {
      "@type": "HowToStep",
      position: 3,
      name: "Contribute to Open Source",
      text: "Browse FWTX DAO repositories and contribute to open source tools, guides, and civic infrastructure.",
      url: "https://github.com/FWTX-DAO",
    },
    {
      "@type": "HowToStep",
      position: 4,
      name: "Become a Member",
      text: "Sign up at dao.fwtx.city for active membership and take part in DAO governance and community programs.",
      url: "https://dao.fwtx.city",
    },
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://fwtx.city" },
    { "@type": "ListItem", position: 2, name: "Programs", item: "https://fwtx.city/programs" },
  ],
};
---

<Layout
  title="Programs"
  description="Build with HackFW, support Fort Worth's innovation community, join an open community roundtable, or learn about the Fort Worth Innovation Forum.">
  <script type="application/ld+json" set:html={JSON.stringify(howToJoinSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Container>
    <Sectionhead as="h1">
      <Fragment slot="title">Programs</Fragment>
      <Fragment slot="desc">Build, partner, and connect with Fort Worth's technology community</Fragment>
    </Sectionhead>

    <div class="mx-auto mt-16 grid max-w-5xl gap-6 md:grid-cols-2">
      {programs.map(({ name, availability, description, href, cta, external, icon }) => (
        <a
          href={href}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
          class="glass-card group flex min-h-[280px] flex-col rounded-xl border border-slate-700/50 p-8 transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:border-blue-400/40 hover:shadow-glow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-950">
          <div class="flex items-start justify-between gap-4">
            <span class="inline-flex items-center gap-2 rounded-full border border-slate-600/60 bg-slate-900/60 px-3 py-1 text-xs font-semibold text-slate-300">
              <span class="h-2 w-2 rounded-full bg-neon-cyan" aria-hidden="true"></span>
              {availability}
            </span>
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-neon-cyan/10 transition-colors duration-300 group-hover:bg-neon-cyan/15">
              <svg class="h-6 w-6 text-neon-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
              </svg>
            </div>
          </div>
          <h2 class="mt-8 font-display text-2xl text-white transition-colors duration-300 group-hover:text-neon-cyan">{name}</h2>
          <p class="mt-3 text-slate-300 leading-relaxed">{description}</p>
          <span class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-blue-400 transition-colors duration-300 group-hover:text-blue-300">
            {cta}
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      ))}
    </div>

    <!-- How to Join -->
    <div class="mx-auto mt-20 mb-16 max-w-4xl">
      <h2 class="mb-10 text-center font-display text-4xl text-white">How to Get Involved</h2>
      <ol class="space-y-6">
        {involvementSteps.map(({ step, title, body, href, cta }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="glass-card group flex items-start gap-6 rounded-xl p-6 transition-[border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-blue-400/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-950">
              <span class="shrink-0 select-none font-display text-4xl text-frontier-amber/40">{step}</span>
              <div>
                <h3 class="mb-1 text-lg font-semibold text-white transition-colors duration-300 group-hover:text-neon-cyan">{title}</h3>
                <p class="text-sm leading-relaxed text-slate-400">{body}</p>
                <span class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-blue-400 transition-colors duration-300 group-hover:text-blue-300">
                  {cta}
                  <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</Layout>
