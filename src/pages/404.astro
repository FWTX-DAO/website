---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 Not Found" noindex={true}>
  <Container>
    <div class="min-h-[calc(100vh-16rem)] flex items-center justify-center">
      <div class="mt-16 text-center">
        <h1 class="font-display text-8xl lg:text-9xl font-bold">
          <span class="gradient-text">404</span>
        </h1>
        <p class="text-xl mt-4 text-slate-400">You've ridden off the trail, partner.</p>
        <p class="text-sm mt-2 text-slate-500">Nothing out here but tumbleweeds and broken links.</p>
        <div class="mx-auto mt-8 max-w-2xl rounded-lg border border-slate-700 bg-navy-900/70 p-6 text-left">
          <h2 class="text-lg font-semibold text-white">Find the right trail</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">
            Visitors, crawlers, and AI agents can recover through the{" "}
            <a href="/sitemap" class="text-blue-400 underline underline-offset-4 hover:text-blue-300">HTML sitemap</a>,
            {" "}<a href="/sitemap-index.xml" class="text-blue-400 underline underline-offset-4 hover:text-blue-300">XML sitemap</a>, or{" "}
            <a href="/llms.txt" class="text-blue-400 underline underline-offset-4 hover:text-blue-300">llms.txt</a>.
            Membership starts at <a href="https://dao.fwtx.city" class="text-blue-400 underline underline-offset-4 hover:text-blue-300">dao.fwtx.city</a>.
          </p>
          <pre class="mt-4 overflow-x-auto whitespace-pre-wrap rounded bg-navy-950 p-4 text-xs leading-relaxed text-slate-400"><code># Fort Worth DAO — 404
[Home](https://fwtx.city/) · [Sitemap](https://fwtx.city/sitemap) · [AI guide](https://fwtx.city/llms.txt)</code></pre>
        </div>
        <div class="mt-8">
          <a
            href="/"
            class="bg-frontier-amber text-cyber-dark font-semibold px-6 py-3 rounded-lg inline-flex items-center gap-2 hover:bg-frontier-amber/90 hover:shadow-glow-amber transition duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Back to Home
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>
