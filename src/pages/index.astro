---
import Container from "@components/container.astro";
import Cta from "@components/cta.astro";
import Features from "@components/features.astro";
import Hero from "@components/hero.astro";
import HowItWorks from "@components/howitworks.astro";
import UpcomingEvents from "@components/upcomingevents.astro";
import InnovationBounty from "@components/innovationbounty.astro";
import DonateBanner from "@components/donatebanner.astro";
import Sponsorship from "@components/sponsorship.astro";
import HackFW from "@components/hackfw.astro";
import TalentNetwork from "@components/talentnetwork.astro";
import InnovationLab from "@components/innovationlab.astro";
import PixelLogoGrid from "@components/ui/pixel-logo-grid";
import Layout from "@layouts/Layout.astro";

const faqs = [
  {
    question: "What is FWTX DAO?",
    answer: "FWTX DAO, also known as Fort Worth DAO, is a Web3 community and decentralized autonomous organization. Its legal entity, Fort Worth DAO LCA, is a 501(c)(3) nonprofit. It focuses on education, digital sovereignty, open source technology, and civic innovation across Fort Worth and Greater Texas.",
  },
  {
    question: "How do I join Fort Worth DAO?",
    answer: "Visit dao.fwtx.city, choose Enter Platform or Sign In, and use the account-creation option presented by the member portal. Read the constitution for membership expectations, then attend a public roundtable or workshop and connect with the community. For help, email community@fwtx.city.",
  },
  {
    question: "What events does FWTX DAO host?",
    answer: "FWTX DAO hosts regular community roundtables, educational workshops on blockchain and cybersecurity, HackFW hackathons, and innovation bounty programs. Our events focus on growing a technologist culture in Fort Worth through digital assets, emerging tech, and information age first principles.",
  },
  {
    question: "What is a Municipal DAO?",
    answer: "A municipal DAO is a community-led decentralized autonomous organization focused on a particular city or region. Fort Worth DAO uses Web3 principles such as transparency, decentralization, and shared participation to support education, digital sovereignty, workforce development, and public-interest technology in Fort Worth and Greater Texas.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title=""
  description="Fort Worth DAO is a Web3 community and 501(c)(3) nonprofit DAO serving Fort Worth and Greater Texas through education, digital sovereignty, and civic innovation.">
  <Fragment slot="head">
    <script is:inline>function loadScript(a){var b=document.getElementsByTagName("head")[0],c=document.createElement("script");c.type="text/javascript",c.src="https://tracker.metricool.com/resources/be.js",c.onreadystatechange=a,c.onload=a,b.appendChild(c)}loadScript(function(){beTracker.t({hash:"1370eb286fed65406a0e05e54ace2d25"})});</script>
  </Fragment>

  <Container>
    <Hero />
    <HowItWorks />
    <div class="mb-20">
      <UpcomingEvents />
    </div>
    <Features />
    <DonateBanner />
    <Sponsorship className="my-20" />
    <InnovationBounty />
    <TalentNetwork />
    <HackFW />
    <InnovationLab />
    <PixelLogoGrid client:load />

    <!-- FAQ Section -->
    <div class="my-20">
      <div class="max-w-4xl mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="font-display text-4xl lg:text-5xl font-bold tracking-tight text-white">
            Frequently Asked <span class="gradient-text">Questions</span>
          </h2>
          <p class="text-lg text-slate-400 mt-4">
            Learn more about FWTX DAO and Web3 civic innovation in Fort Worth.
          </p>
        </div>
        <div class="space-y-6">
          {faqs.map((faq) => (
            <div class="glass-card rounded-xl p-6">
              <h3 class="text-xl font-semibold text-white mb-3">{faq.question}</h3>
              <p class="text-slate-400 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <Cta />
  </Container>
</Layout>
