---
import Container from "./container.astro";
import Sectionhead from "./sectionhead.astro";
import { Icon } from "astro-icon/components";
---

<Container>
  <Sectionhead>
    <Fragment slot="title">Fort Worth Talent Network</Fragment>
    <Fragment slot="desc">
      Connect with the people building Fort Worth's technology and innovation ecosystem
    </Fragment>
  </Sectionhead>

  <a
    href="https://talent.fwtx.city"
    target="_blank"
    rel="noopener noreferrer"
    class="group mx-auto mt-12 flex max-w-4xl flex-col gap-6 rounded-xl border border-blue-500/30 p-8 glass-card transition-[border-color,box-shadow] duration-300 hover:border-blue-400/60 hover:shadow-glow-sm md:flex-row md:items-center md:justify-between"
  >
    <div class="flex items-start gap-5">
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-blue-500/10 text-blue-400 transition-colors duration-300 group-hover:bg-blue-500/20">
        <Icon name="mdi:account-group" class="h-8 w-8" aria-hidden="true" />
      </div>
      <div>
        <h3 class="text-2xl font-bold text-white transition-colors duration-300 group-hover:text-blue-300">
          Join the Fort Worth Talent Network
        </h3>
        <p class="mt-2 max-w-2xl text-slate-400">
          Create your profile, share your skills, and connect with local builders, employers, and opportunities.
        </p>
      </div>
    </div>
    <span class="inline-flex min-h-[44px] shrink-0 items-center justify-center gap-2 rounded bg-blue-600 px-5 py-2.5 font-semibold text-white transition-[background-color,border-color,box-shadow,transform] duration-300 group-hover:bg-blue-500 group-hover:shadow-glow-blue group-active:scale-[0.96]">
      Join the Network
      <Icon name="mdi:arrow-right" class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
    </span>
  </a>
</Container>
