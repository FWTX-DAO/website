---
import Link from "@components/ui/link.astro";
import SolarCycle from "@components/solarcycle.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 items-start lg:items-center pt-12 pb-8 md:pb-16 gap-x-12 gap-y-8">
  <div class="w-full max-w-xl mx-auto lg:max-w-none animate-fade-in">
    <p class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-full border border-blue-500/20 bg-navy-900/60 px-3 py-1 font-mono text-xs text-slate-400">
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-green-400"></span>
      </span>
      <span>DAO Status: <span class="text-green-400">Active</span></span>
      <span class="text-slate-600" aria-hidden="true">/</span>
      <span>501(c)(3) Nonprofit</span>
      <span class="text-slate-600" aria-hidden="true">/</span>
      <span>Fort Worth, TX</span>
    </p>

    <h1
      class="mt-5 font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight text-white leading-[0.95]">
      Scaling Digital
      <br />
      Sovereignty
      <br />
      <span class="text-blue-400">in Fort Worth</span>
    </h1>

    <div class="mt-5 max-w-xl space-y-3 text-base leading-relaxed text-slate-300">
      <p class="text-lg text-slate-200">
        Fort Worth DAO is a 501(c)(3) nonprofit and <span class="text-blue-400 font-medium">modern-day guild</span>
        focused on education and digital sovereignty across Fort Worth and Greater Texas. We're a
        Web3 community and decentralized autonomous organization, with Fort Worth DAO LCA as our legal entity.
      </p>
      <p>
        We teach digital ownership, cryptography, blockchain, cybersecurity, and emerging
        technology, and we grow <span class="text-blue-400 font-medium">open source ecosystems</span> in
        our civic innovation lab, building toward a more technologically literate, informed, and
        equitable Fort Worth.{" "}
        <a
          href="https://constitution.fwtx.city"
          class="text-blue-400 hover:text-blue-300 transition-colors duration-300 underline decoration-blue-500/30 hover:decoration-blue-400 underline-offset-4">
          Read our constitution and whitepaper.
        </a>
      </p>
    </div>

    <div class="mt-7 flex flex-wrap gap-3">
      <Link
        href="https://dao.fwtx.city"
        target="_blank"
        style="primary"
        class="flex gap-2 items-center justify-center group min-h-[44px]"
        rel="noopener">
        <Icon class="w-5 h-5" name="bx:bx-user-plus" aria-hidden="true" />
        Join the DAO
      </Link>
      <Link
        href="https://t.me/fwtxdao"
        target="_blank"
        style="outline"
        size="md"
        class="flex gap-2 items-center justify-center group min-h-[44px]"
        rel="noopener">
        <Icon class="w-5 h-5" name="bx:bxl-telegram" aria-hidden="true" />
        Telegram
      </Link>
      <Link
        style="outline"
        size="md"
        rel="noopener"
        href="https://github.com/FWTX-DAO"
        class="flex gap-2 items-center justify-center group min-h-[44px]"
        target="_blank">
        <Icon class="w-4 h-4" name="bx:bxl-github" aria-hidden="true" />
        GitHub
      </Link>
      <a
        href="https://buy.stripe.com/9B66oHfy50e1b7C7buak000"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 min-h-[44px] px-4 py-2 rounded font-semibold text-frontier-amber border-2 border-frontier-amber/40 hover:border-frontier-amber hover:bg-frontier-amber/10 transition-[border-color,background-color] duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-frontier-amber/50 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-950">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        Donate
      </a>
    </div>

    <a
      href="/events"
      class="group mt-6 flex w-fit items-center gap-3 rounded-lg border border-slate-700/60 bg-navy-900/50 px-4 py-3 text-sm text-slate-300 transition-[border-color] duration-200 hover:border-blue-400/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400">
      <Icon name="mdi:calendar-clock" class="h-5 w-5 shrink-0 text-blue-400" aria-hidden="true" />
      <span>
        <span class="font-semibold text-white">New here?</span> Drop into an open roundtable,
        Wednesdays at 12pm CST at CreateFW.
      </span>
      <Icon name="mdi:arrow-right" class="h-4 w-4 shrink-0 text-blue-400 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
    </a>
  </div>

  <div class="w-full max-w-xl mx-auto lg:max-w-none">
    <SolarCycle />
  </div>
</main>
