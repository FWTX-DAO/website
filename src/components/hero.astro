---
import heroImage from "../assets/hero.svg";
import hackfwBanner from "../assets/hackfw-made-challenge.png";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 place-items-center lg:items-start lg:justify-items-stretch pt-16 pb-8 md:pt-12 md:pb-24 gap-8 lg:gap-12">
  <div class="py-6 md:order-1 w-full max-w-xl lg:max-w-none">
    <div class="flex flex-col gap-4 w-full">
      <a
        href="https://hack.fwtx.city/"
        target="_blank"
        rel="noopener noreferrer"
        class="group block w-full rounded-lg origin-center active:scale-[0.96] transition-transform duration-150 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-950">
        <img
          src={hackfwBanner.src}
          alt="HackFW MADE Challenge, October 1–30, 2026 in Fort Worth, Texas. Opens the event website in a new tab."
          width={hackfwBanner.width}
          height={hackfwBanner.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="w-full h-auto rounded-lg outline outline-1 -outline-offset-1 outline-white/10 group-hover:outline-white/20 group-hover:shadow-glow-sm transition-[outline-color,box-shadow] duration-150 ease-out"
        />
      </a>
      <div class="relative hidden md:block w-full">
        <img
          src={heroImage.src}
          alt="FWTX DAO Process"
          width={heroImage.width}
          height={heroImage.height}
          loading="eager"
          decoding="async"
          class="relative z-10 w-full h-auto invert opacity-85"
        />
      </div>
    </div>
  </div>
  <div class="animate-fade-in">
    <h1
      class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight text-white leading-[0.95]">
      Scaling Digital
      <br />
      Sovereignty
      <br />
      <span class="text-blue-400">in Fort Worth</span>
    </h1>
    <div class="mt-4 max-w-xl space-y-3 text-base leading-normal text-slate-300">
      <p>
        Fort Worth DAO is a <span class="text-blue-400 font-medium">Web3 community</span> and
        decentralized autonomous organization. Its legal entity, Fort Worth DAO LCA,
        is a 501(c)(3) nonprofit focused on education and digital sovereignty across Fort Worth and Greater Texas.
      </p>
      <p>
        We teach the foundations of digital ownership, cryptography, blockchain,
        cybersecurity, and emerging technology by fostering{" "}
        <span class="text-blue-400 font-medium">open source ecosystems</span>, knowledge
        sharing, and assets in our civic innovation lab.
      </p>
      <p>
        We aim to create a more technologically literate, informed, and
        equitable digital future for an efficient and optimized city.{" "}
        <a
          href="https://constitution.fwtx.city"
          class="text-blue-400 hover:text-blue-300 transition-colors duration-300 underline decoration-blue-500/30 hover:decoration-blue-400 underline-offset-4">
          Read our constitution and whitepaper.
        </a>
      </p>
    </div>
    <div class="mt-6 flex flex-col sm:flex-row gap-4">
      <Link
        href="https://dao.fwtx.city"
        target="_blank"
        style="primary"
        class="flex gap-2 items-center justify-center group"
        rel="noopener">
        <Icon class="w-5 h-5 group-hover:animate-pulse" name="bx:bx-user-plus" aria-hidden="true" />
        Join
      </Link>
      <Link
        href="https://t.me/fwtxdao"
        target="_blank"
        style="primary"
        class="flex gap-2 items-center justify-center group"
        rel="noopener">
        <Icon class="w-5 h-5" name="bx:bxl-telegram" aria-hidden="true" />
        Telegram
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="https://github.com/FWTX-DAO"
        class="flex gap-2 items-center justify-center group"
        target="_blank">
        <Icon class="text-blue-400 w-4 h-4" name="bx:bxl-github" aria-hidden="true" />
        GitHub
      </Link>
      <a
        href="https://buy.stripe.com/9B66oHfy50e1b7C7buak000"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-semibold px-6 py-3 rounded text-center border-2 border-blue-600 hover:border-blue-500 transition-all duration-300 hover:shadow-[0_0_18px_rgba(59,130,246,0.4)] focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-950">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        Donate
      </a>
    </div>

    <!-- Status indicator -->
    <div class="mt-6 flex items-center gap-3">
      <div class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-green-400"></span>
      </div>
      <span class="text-sm text-slate-400 font-mono">DAO Status: <span class="text-green-400">Active</span></span>
    </div>
  </div>
</main>
